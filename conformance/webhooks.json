      "headers": {
        "Wefunder-Signature": "t=1700000000,v1=ccc88edb1e2f74eb617b1731ee1fc61414710bdce921ca722c3ab55b09d58266"
      },
      "now": 1700000000,
      "expect": {
        "result": "ok",
        "event": {
          "id": "evt_abc",
          "event": "investment.executed",
          "mode": "test",
          "timestamp": 1700000000,
          "created_at": "2026-09-24T12:00:00Z"
        }
      }
    },
    {
      "name": "typed envelope: data passes through untouched",
      "tolerance_seconds": 300,
      "secret": "whsec_test_abcdef0123456789",
      "payload": "{\"id\":\"evt_abc\",\"event\":\"investment.executed\",\"created_at\":\"2026-09-24T12:00:00Z\",\"mode\":\"test\",\"data\":{\"id\":\"inv_1\",\"status\":\"executed\",\"offering\":\"ofr_1\",\"amounts\":{\"committed\":50000},\"investor\":{\"id\":\"usr_1\",\"name\":\"Alex Example\"}}}",
      "headers": {
        "wefunder-signature": "t=1700000000,v1=ccc88edb1e2f74eb617b1731ee1fc61414710bdce921ca722c3ab55b09d58266"
      },
      "now": 1700000000,
      "expect": {
        "result": "ok",
        "event": {
          "id": "evt_abc",
          "event": "investment.executed",
          "mode": "test",
          "timestamp": 1700000000,
          "data": {
            "id": "inv_1",
            "status": "executed",
            "offering": "ofr_1",
            "amounts": {
              "committed": 50000
            },
            "investor": {
              "id": "usr_1",
              "name": "Alex Example"
            }
          }
        }
      }
    },
    {
      "name": "correctly signed non-JSON body → invalid_payload",
      "tolerance_seconds": 300,
      "secret": "whsec_test_abcdef0123456789",
      "payload": "not json at all",
      "headers": {
        "wefunder-signature": "t=1700000000,v1=5b1042f89a82e10dfbe817b35da837d15083ff3290cbd3bc7677b888d95a1f99"
      },
      "now": 1700000000,
      "expect": {
        "result": "invalid_payload"
      }
    },
    {
      "name": "event name unknown to the SDK still verifies; data untyped",
      "tolerance_seconds": 300,
      "secret": "whsec_test_abcdef0123456789",
      "payload": "{\"id\":\"evt_f\",\"event\":\"offering.renamed\",\"created_at\":\"x\",\"mode\":\"live\",\"data\":{\"k\":1}}",
      "headers": {
        "wefunder-signature": "t=1700000000,v1=22e2caf114be6703b4525b9e2fa9bfae7aa57f3f8cbe9b2b3189ac4a8694c640"
      },
      "now": 1700000000,
      "expect": {
        "result": "ok",
        "event": {
          "id": "evt_f",
          "event": "offering.renamed",
          "mode": "live",
