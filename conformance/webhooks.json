        }
      }
    },
    {
      "name": "mode defaults to live when the envelope omits it",
      "tolerance_seconds": 300,
      "secret": "whsec_test_abcdef0123456789",
      "payload": "{\"id\":\"evt_m\",\"event\":\"offering.opened\",\"data\":{}}",
      "headers": {
        "wefunder-signature": "t=1700000000,v1=e0b47cc2c6523069dababeee4e30837c1e4902a29baad4f920550c7bebdb5b41"
