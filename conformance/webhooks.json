  "parse_header": [
    {
      "header": "t=1700000000,v1=abc",
      "expect": {
        "timestamp": 1700000000,
        "signatures": [
          "abc"
        ]
      }
    },
    {
      "header": "t=1,v1=aa,v1=bb,v2=future",
      "expect": {
        "timestamp": 1,
        "signatures": [
          "aa",
          "bb"
        ]
      },
      "note": "unknown keys ignored (forward compatible)"
    },
    {
      "header": " t=5 , v1=zz ",
